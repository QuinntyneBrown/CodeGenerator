@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Render syntax from a model

Container_Boundary(core, "CodeGenerator.Core") {
  Component(gen, "SyntaxGenerator", "C# class", "Validates and dispatches on runtime type")
  Component(cache, "Dispatcher cache", "ConcurrentDictionary<Type, Func>", "One compiled delegate per model type")
  Component(exec, "StrategyExecutor", "C# class", "Runs a strategy and converts failures to Result")
  Component(diag, "DiagnosticContext", "C# ambient context", "Records strategy, model type, and phase")
  Component(sbcache, "StringBuilderCache", "C# static pool", "Reuses composition buffers")
}
Container_Boundary(targets, "Target packages") {
  Component(strategy, "ISyntaxGenerationStrategy<T>", "C# interface", "Renders one construct to text")
}

Rel(gen, cache, "Reads and populates")
Rel(gen, strategy, "Selects highest priority match")
Rel(exec, strategy, "Executes")
Rel(exec, diag, "Publishes execution context to")
Rel(strategy, sbcache, "Composes output using")
@enduml
